# サーバー B（社員証画像の生成サーバー）の systemd ユニット。
#
#   sudo cp deploy/illuse-card.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now illuse-card
#
# 公開は Tailscale Funnel（8443 番）で行う。サーバー自体は 127.0.0.1 でのみ待ち受ける。
#   tailscale funnel --bg --https=8443 http://127.0.0.1:8081

[Unit]
Description=ILLUSE Corp. employee ID card generator (server B)
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus17th
Group=prometheus17th
WorkingDirectory=/home/prometheus17th/alice/backend
ExecStart=/home/prometheus17th/alice/backend/bin/illuse-card-server
Environment=ILLUSE_ADDR=127.0.0.1:8081
Environment=ILLUSE_DB=/home/prometheus17th/alice/backend/data/cards.db
Environment=ILLUSE_ALLOWED_ORIGINS=https://illuse-corp.u-diary.art
Environment=ILLUSE_RATE_LIMIT=5
Restart=on-failure
RestartSec=3

# 最低限のサンドボックス（DB のディレクトリ以外は書き込み不可）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/prometheus17th/alice/backend/data

[Install]
WantedBy=multi-user.target
